# ---- Groq (STT + LLM) ----
GROQ_API_KEY=gsk_replace_me
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=openai/gpt-oss-20b
# Fast model used only for structured slot extraction (keeps turns snappy):
GROQ_EXTRACTION_MODEL=openai/gpt-oss-20b

# ---- Postgres ----
POSTGRES_USER=voice
POSTGRES_PASSWORD=voice
POSTGRES_DB=voiceagent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Orpheus TTS (local GPU) ----
ORPHEUS_MODEL_PATH=./models/orpheus-3b-Q4_K_M.gguf
TTS_SAMPLE_RATE=24000

# ---- App ----
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ---- Twilio (Sprint 5, leave blank for now) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
