    def test_6_calls_with_5_credits_worth(self):
        """5 calls succeed, 6th fails (300 credits = exactly 5 × 60)."""
        async def _t():
            await _fund_org(self.db, "org-limit", 300)
            svc = self._svc()
    
            tasks = [
